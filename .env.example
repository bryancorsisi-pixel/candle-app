# Copie este arquivo para ".env.local" e preencha com suas próprias chaves.
# NUNCA suba o .env.local pro GitHub — ele fica de fora automaticamente (veja .gitignore).

# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Painel do Resend > API Keys
RESEND_API_KEY=
# E-mail remetente, com domínio verificado no Resend (Domains). Enquanto não
# verificar um domínio próprio, dá pra testar com o domínio de testes do Resend.
RESEND_FROM="Candle <lembrete@seudominio.com>"

# Painel do Asaas > Integrações > API Key. Comece com a chave de SANDBOX
# (asaas_base_url de sandbox) pra testar sem dinheiro real — só troque pra
# produção depois de validar o fluxo completo (seção 13 do doc de arquitetura).
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# Uma senha aleatória que você mesmo escolhe e cadastra no painel do Asaas ao
# criar o webhook (Integrações > Webhooks) — é isso que garante que só o
# Asaas consegue chamar /api/asaas/webhook.
ASAAS_WEBHOOK_TOKEN=

# Uma senha aleatória que só você conhece, pra proteger as rotas de cron
# (gere uma em https://www.uuidgenerator.net/ ou peça pro Claude Code gerar)
CRON_SECRET=

# URL pública do site (usada nos links dos e-mails). Em produção, a URL do
# seu domínio no Vercel; localmente, deixe como está.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
